# Chiavi API per i modelli LLM (compila quella del provider scelto)
OPENAI_API_KEY=sk-proj-INSERISCI_QUI
GEMINI_API_KEY=AIzaSyINSERISCI_QUI
GROQ_API_KEY=gsk_INSERISCI_QUI

# Provider selezionato (openai | groq | gemini)
LLM_PROVIDER=openai

# Modelli per Groq (Llama-3.3-70b consigliato per la patch)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_JUDGE_MODEL=llama-3.3-70b-versatile

# Modelli per Gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_JUDGE_MODEL=gemini-2.5-pro

# Configurazione sessione DVWA
# (Opzionale: se omesso o lasciato vuoto, l'agente esegue il login automatico admin/password)
PHPSESSID=

# Tracciamento ed Osservabilità con LangSmith
# Imposta LANGCHAIN_TRACING_V2=true e inserisci la tua chiave per tracciare le run su smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_INSERISCI_QUI
LANGCHAIN_PROJECT=dvwa-llm-agent
